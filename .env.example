# ===========================================
# 🏴‍☠️ Arr Stack Configuration
# ===========================================
# Copy this file to .env and fill in your values
# ===========================================

# ===========================================
# Mullvad WireGuard Configuration
# Get these from: https://mullvad.net/en/account/#/wireguard-config
# ===========================================
MULLVAD_PRIVATE_KEY=your_wireguard_private_key_here
MULLVAD_ADDRESS=10.x.x.x/32

# VPN exit country (Spain, Romania, Sweden, etc.)
VPN_COUNTRY=Spain

# ===========================================
# Reverse Proxy Hostnames
# ===========================================
# LAN hostname (find with: hostname on Debian)
ARR_HOSTNAME_LOCAL=arr-box.local
# NetBird VPN hostname
ARR_HOSTNAME_NETBIRD=arr-box.netbird.cloud

# ===========================================
# Network
# ===========================================
# Your local network subnet (for accessing services)
LAN_SUBNET=192.168.1.0/24

# ===========================================
# Paths
# ===========================================
# Where torrents are downloaded
DOWNLOAD_PATH=/mnt/downloads

# Where your media library lives (will contain /tv and /movies subdirs)
MEDIA_PATH=/mnt/media

# ===========================================
# User/Group IDs
# Linux: match arrbox service user (id -u arrbox / id -g arrbox)
# ===========================================
PUID=1100
PGID=1100
TZ=Europe/Berlin

# ===========================================
# API Keys (get these from each service's Settings → General)
# These are auto-generated on first run - copy them here for Homepage
# ===========================================
SONARR_API_KEY=
RADARR_API_KEY=
PROWLARR_API_KEY=
BAZARR_API_KEY=
JELLYFIN_API_KEY=
QBITTORRENT_PASSWORD=

# ===========================================
# OpenSubtitles.com (optional, for Bazarr)
# Create free account at: https://www.opensubtitles.com/
# Get API key from: https://www.opensubtitles.com/en/consumers
# ===========================================
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
