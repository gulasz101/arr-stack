# ===========================================
# Mullvad WireGuard Configuration
# ===========================================
MULLVAD_PRIVATE_KEY=your_wireguard_private_key_here
MULLVAD_ADDRESS=10.x.x.x/32

# ===========================================
# Network
# ===========================================
LAN_SUBNET=192.168.1.0/24

# ===========================================
# Paths
# ===========================================
DOWNLOAD_PATH=/path/to/Media/downloads
MEDIA_PATH=/path/to/Media

# ===========================================
# User/Group (macOS: id -u / id -g)
# ===========================================
PUID=501
PGID=20
TZ=Europe/Berlin

# ===========================================
# API Keys (get these from each service's Settings → General)
# ===========================================
SONARR_API_KEY=
RADARR_API_KEY=
PROWLARR_API_KEY=
BAZARR_API_KEY=
JELLYFIN_API_KEY=
QBITTORRENT_PASSWORD=

# ===========================================
# OpenSubtitles (for Bazarr)
# ===========================================
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
